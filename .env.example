# --- Frontend (Vite, baked into the static build) ---
# OAuth client IDs are public. Get them from the same OAuth app you set up
# for the Cloudflare Pages Functions below.
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=

# --- Cloudflare Pages Functions (server-side, set in the Pages dashboard) ---
# These hold the OAuth client secrets. The browser never sees them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Migration script only (one-time use, see DEPLOY.md) ---
# Path to the SQLite DB downloaded from the old Fly deploy.
DATA_DIR=./data
